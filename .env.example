# Provider keys are read on the server only and must never be exposed to the
# browser. Do not prefix any of these with NEXT_PUBLIC_.
OVERSET_OCR_API_KEY=
OVERSET_VISION_API_KEY=
OVERSET_TRANSLATION_API_KEY=
OVERSET_CLEANING_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage for uploaded, cleaned, and translated pages
OVERSET_STORAGE_BUCKET=
OVERSET_STORAGE_REGION=

# Supabase — accounts, projects, and page images. Without these, Overset keeps
# everything in the browser. The URL and publishable key are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: account deletion and the shared rate limiter.
SUPABASE_SERVICE_ROLE_KEY=

# Contextual OCR, translation, alternatives, romanization and proofreading.
ANTHROPIC_API_KEY=
OVERSET_AI_MODEL=claude-sonnet-5-5
OVERSET_SITE_URL=https://useoverset.com

# Resend: use a verified sender. Reuse its SMTP settings in Supabase Auth.
RESEND_API_KEY=
OVERSET_EMAIL_FROM="Overset <noreply@useoverset.com>"
OVERSET_CONTACT_EMAIL=hello@useoverset.com
# Random server token used by Vercel's scheduled outbox retry.
CRON_SECRET=

# Run scripts/configure-stripe.mjs to prepare these after supplying the key.
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_PUBLISHER_MONTHLY=
STRIPE_PRICE_PUBLISHER_YEARLY=
STRIPE_PRICE_PAGES_100=
